# iOS signing, build and upload. Usage: docs/release.md.
#
# Signing relies on match: the distribution certificate, private key and App
# Store profile are stored encrypted in the repo the Matchfile declares. CI
# reads them read-only and never creates anything on Apple's side. Only the
# `certificates` lane, run by hand from a Mac, generates them.
#
# This replaces Xcode's automatic signing: on an ephemeral runner, it creates
# a development certificate on every run, then fails on the next one for
# lacking its private key.

require "json"

default_platform(:ios)

ROOT = File.expand_path("..", __dir__)
IOS_DIR = File.join(ROOT, "ios")
OUTPUT_DIR = File.join(ROOT, "build", "ios")
APP_IDENTIFIER = JSON.parse(File.read(File.join(ROOT, "app.json"))).dig("expo", "ios", "bundleIdentifier")

platform :ios do
  desc "Crée ou renouvelle le certificat de distribution et le profil App Store (Mac, clé API Admin)"
  lane :certificates do
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: false,
      # The certificate expires after a year: re-running the lane replaces it,
      # and match then regenerates the profile Apple invalidated along with it.
      renew_expired_certs: true,
      api_key: asc_api_key,
    )
  end

  desc "Signe et compile le projet généré par `expo prebuild` (CI)"
  lane :build do
    project = xcode_project_name
    setup_ci
    match(type: "appstore", app_identifier: APP_IDENTIFIER, readonly: true)

    # Variables set by match based on the profile it just installed.
    installed = "sigh_#{APP_IDENTIFIER}_appstore"
    update_code_signing_settings(
      path: File.join(IOS_DIR, "#{project}.xcodeproj"),
      # The app target only: Pods targets refuse having a profile imposed on
      # them, which happens if signing is passed as an xcodebuild argument.
      targets: [project],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: required_env("#{installed}_team-id"),
      code_sign_identity: required_env("#{installed}_certificate-name"),
      profile_name: required_env("#{installed}_profile-name"),
    )

    build_app(
      workspace: File.join(IOS_DIR, "#{project}.xcworkspace"),
      scheme: project,
      configuration: "Release",
      output_directory: OUTPUT_DIR,
      output_name: "#{project}.ipa",
      buildlog_path: File.join(OUTPUT_DIR, "logs"),
      # The build number is set by app.config.ts; Xcode doesn't touch it.
      export_options: { manageAppVersionAndBuildNumber: false },
    )
  end

  desc "Envoie l'IPA compilée à App Store Connect, d'où elle part dans TestFlight (CI)"
  lane :upload do
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: File.join(OUTPUT_DIR, "#{xcode_project_name}.ipa"),
      # "What to Test": the release notes from src/changelog.ts, set by the
      # workflow. Absent locally, where the build only serves to verify.
      changelog: ENV["RELEASE_NOTES"],
      # Waiting for Apple's processing would burn runner time for nothing: an
      # internal testers group on automatic distribution gets the build as
      # soon as it's ready.
      skip_waiting_for_build_processing: true,
    )
  end
end

# In CI, the key arrives base64-encoded via a secret; on a Mac, we point to
# the .p8 file downloaded from App Store Connect.
def asc_api_key
  key = { key_id: required_env("ASC_KEY_ID"), issuer_id: required_env("ASC_ISSUER_ID") }
  if ENV["ASC_API_KEY_P8_BASE64"].to_s.empty?
    key[:key_filepath] = required_env("ASC_KEY_PATH")
  else
    key[:key_content] = ENV["ASC_API_KEY_P8_BASE64"]
    key[:is_key_content_base64] = true
  end
  app_store_connect_api_key(**key)
end

def required_env(name)
  value = ENV[name].to_s
  UI.user_error!("Variable d'environnement #{name} absente (voir docs/release.md).") if value.empty?
  value
end

# `expo prebuild` names the project after `expo.name`: we read it rather than
# hardcoding it, so renaming the app doesn't break the build.
def xcode_project_name
  workspaces = Dir[File.join(IOS_DIR, "*.xcworkspace")]
  UI.user_error!("Projet iOS introuvable : lancez d'abord `npx expo prebuild --platform ios`.") unless workspaces.one?
  File.basename(workspaces.first, ".xcworkspace")
end
