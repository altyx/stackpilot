---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Width of the screen, in CSS pixels, before the frame. */
  width: number;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { src, alt, width, loading = 'lazy', class: className } = Astro.props;
---

<div class:list={['phone', className]} style={`--screen: ${width}px`}>
  <Image src={src} width={width} densities={[1, 2]} loading={loading} alt={alt} />
</div>
