{
  "expo": {
    "name": "StackPilot",
    "slug": "stackpilot",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/ios-light-1024.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.stackpilot",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/ios-light-1024.png",
        "dark": "./assets/ios-dark-1024.png",
        "tinted": "./assets/ios-tinted-1024.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ic_launcher_foreground-1024.png",
        "monochromeImage": "./assets/ic_launcher_monochrome-1024.png",
        "backgroundColor": "#0F172A"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.stackpilot"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0ba5ec"
        }
      ],
      "./plugins/withAndroidReleaseSigning"
    ],
    "scheme": "stackpilot",
    "newArchEnabled": true,
    "backgroundColor": "#0d1117",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "837ab21c-e789-40b6-b77a-91a3e0276ad4"
      }
    },
    "owner": "altyx-lab"
  }
}
