# Copiez ce fichier en .env et renseignez vos valeurs.
# .env n'est pas versionne : il contient un jeton d'acces.

# Reseau Docker sur lequel tourne deja Portainer. Pour le trouver :
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' portainer
PORTAINER_NETWORK=portainer_default

# URL de Portainer vue depuis ce reseau : nom du conteneur et port interne
# (9443 en HTTPS par defaut), et non le port publie sur l'hote.
PORTAINER_URL=https://portainer:9443

# Portainer genere un certificat auto-signe. Le trajet ne quittant pas la
# machine, on l'accepte ici. Laissez 0 si votre instance a un vrai certificat.
PORTAINER_INSECURE_TLS=1

# Access token Portainer : My account > Access tokens.
PORTAINER_TOKEN=ptr_xxxxxxxxxxxxxxxxxxxxxxxx

# Identifiant de l'environnement a surveiller. Pour le trouver :
#   curl -sk -H "X-API-Key: $PORTAINER_TOKEN" https://VOTRE_PORTAINER/api/endpoints | jq '.[] | {Id, Name}'
ENDPOINT_ID=1

# Jetons des appareils, separes par des virgules. Obtenus dans l'application :
# Environnements > icone cloche > Autoriser les notifications.
EXPO_PUSH_TOKENS=ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]

# Facultatif : conteneurs dont les redemarrages sont attendus.
IGNORE_CONTAINERS=

# Facultatif : fenetre anti-doublon, en secondes.
DEDUPE_SECONDS=120
