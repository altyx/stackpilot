# Copy this file to .env and fill in your values.
# .env is not committed: it holds an access token.

# Docker network Portainer already runs on. To find it:
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' portainer
PORTAINER_NETWORK=portainer_default

# Portainer URL as seen from that network: container name and internal port
# (9443 over HTTPS by default), not the port published on the host.
PORTAINER_URL=https://portainer:9443

# Portainer generates a self-signed certificate. Since the traffic never
# leaves the machine, it is accepted here. Keep 0 if your instance has a real
# certificate.
PORTAINER_INSECURE_TLS=1

# Portainer access token: My account > Access tokens.
PORTAINER_TOKEN=ptr_xxxxxxxxxxxxxxxxxxxxxxxx

# Id of the environment to watch. To find it:
#   curl -sk -H "X-API-Key: $PORTAINER_TOKEN" https://YOUR_PORTAINER/api/endpoints | jq '.[] | {Id, Name}'
ENDPOINT_ID=1

# Device tokens, comma-separated. Get them in the app:
# Settings > Alerts for your containers > Allow notifications.
EXPO_PUSH_TOKENS=ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]

# Optional: containers whose restarts are expected.
IGNORE_CONTAINERS=

# Optional: de-duplication window, in seconds.
DEDUPE_SECONDS=120
